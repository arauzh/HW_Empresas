<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_asosigma_contributions"
            model="ir.ui.view">
        <field name="name">res.partner.form.asosigma.contributions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='applicable_tax_ids']" position="before">
                <field name="is_asosigma_member"/>
            </xpath>

        </field>
    </record>

</odoo>
