<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asosigma_contribution_tree" model="ir.ui.view">
        <field name="name">asosigma.contribution.batch.tree</field>
        <field name="model">asosigma.contribution.batch</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_ordinary" sum="Total Ordinario"/>
                <field name="total_extraordinary" sum="Total Extraordinario"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'posted'"/>
            </tree>
        </field>
    </record>

    <record id="view_asosigma_contribution_form" model="ir.ui.view">
        <field name="name">asosigma.contribution.batch.form</field>
        <field name="model">asosigma.contribution.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_consult" string="Consultar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state != 'cancel'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('cancel')"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        </group>
                        <group string="Totales">
                            <field name="total_ordinary"/>
                            <field name="total_extraordinary"/>
                        </group>
                    </group>
                    <group string="Contabilidad">
                        <group>
                            <field name="journal_id" readonly="state != 'draft'" required="state == 'draft'"/>
                            <field name="accounting_date" readonly="state != 'draft'" required="state == 'draft'"/>
                            <field name="move_ref" invisible="not move_id"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                        <group>
                            <field name="debit_account_id" readonly="state != 'draft'" required="state == 'draft'"/>
                            <field name="ordinary_credit_account_id" readonly="state != 'draft'" required="state == 'draft'"/>
                            <field name="extraordinary_credit_account_id" readonly="state != 'draft'" required="state == 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Aportaciones">
                            <field name="line_ids" readonly="1">
                                <tree decoration-danger="is_member == False">
                                    <field name="date"/>
                                    <field name="identification_id"/>
                                    <field name="employee_id"/>
                                    <field name="payslip_run_name"/>
                                    <field name="concept"/>
                                    <field name="company_id"/>
                                    <field name="is_member" string="¿Es Asociado?" readonly="1"/>
                                    <field name="amount" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Planillas">
                            <field name="run_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_asosigma_contribution" model="ir.actions.act_window">
        <field name="name">Lotes de Ahorro</field>
        <field name="res_model">asosigma.contribution.batch</field>
        <field name="view_mode">tree,form</field>
    </record>

   <record id="view_asosigma_member_account_tree" model="ir.ui.view">
        <field name="name">asosigma.member.account.tree</field>
        <field name="model">asosigma.member.account</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="identification_id"/>
                <field name="employee_id"/>
                <field name="partner_id"/> <field name="company_id"/>
                <field name="total_ordinary" sum="Total Ordinario"/>
                <field name="total_extraordinary" sum="Total Extraordinario"/>
                <field name="total_accumulated" sum="Total Acumulado" decoration-bf="1"/>
            </tree>
        </field>
    </record>

    <record id="view_asosigma_member_account_form" model="ir.ui.view">
        <field name="name">asosigma.member.account.form</field>
        <field name="model">asosigma.member.account</field>
        <field name="arch" type="xml">
            <form create="0">
                <!-- AÑADIMOS EL HEADER CON EL BOTÓN AQUÍ -->
                <header>
                    <button name="action_add_manual_adjustment" type="object" string="Carga / Ajuste Manual" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="partner_id" class="oe_edit_only" string="Contacto Asociado"/>
                        <h1>
                            <field name="partner_id" options="{'no_open': False, 'no_create': True}" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="identification_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_ordinary"/>
                            <field name="total_extraordinary"/>
                            <field name="total_accumulated" class="oe_subtotal_footer_separator" decoration-bf="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle de Aportaciones">
                            <!-- La lista de líneas ahora muestra reference_display -->
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <!-- Esta columna mostrará ASOSIGMA/2026/0001 o MANUAL/2026/0001 -->
                                    <field name="reference_display"/>
                                    <!-- Esta columna mostrará el nombre del Lote, o "Aporte manual" -->
                                    <field name="payslip_run_name"/>
                                    <field name="concept"/>
                                    <field name="amount" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asosigma_member_account" model="ir.actions.act_window">
        <field name="name">Saldos Acumulados</field>
        <field name="res_model">asosigma.member.account</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_asosigma_manual_adjustment_wizard" model="ir.ui.view">
        <field name="name">asosigma.manual.adjustment.wizard.form</field>
        <field name="model">asosigma.manual.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="account_id" invisible="1"/>
                    <field name="date"/>
                    <field name="type"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button string="Confirmar Carga" name="action_confirm" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_asosigma_contribution_line_form" model="ir.ui.view">
        <field name="name">asosigma.contribution.line.form</field>
        <field name="model">asosigma.contribution.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Información del Asociado">
                            <!-- Aquí mostramos el Contacto en vez del empleado -->
                            <field name="partner_id" options="{'no_open': False}"/>
                            <field name="identification_id"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Detalle de Aportación">
                            <field name="date"/>
                            <field name="reference_display" string="Referencia / Lote"/>
                            <field name="payslip_run_name" string="Planilla / Origen"/>
                            <field name="concept"/>
                            <field name="amount"/>
                            <field name="is_manual" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_asosigma_root" name="ASOSIGMA" sequence="10" web_icon="asosigma_contributions,static/description/icon.png"/>
    <menuitem id="menu_asosigma_contributions" name="Aportaciones" parent="menu_asosigma_root" action="action_asosigma_contribution" sequence="1"/>
    <menuitem id="menu_asosigma_accounts" name="Saldos Acumulados" parent="menu_asosigma_root" action="action_asosigma_member_account" sequence="2"/>
</odoo>