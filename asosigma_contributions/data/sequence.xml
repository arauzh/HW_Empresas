<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_asosigma_contribution_batch" model="ir.sequence">
            <field name="name">Lote de Aportaciones ASOSIGMA</field>
            <field name="code">asosigma.contribution.batch</field>
            <field name="prefix">ASOSIGMA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/> </record>

            <record id="seq_asosigma_manual_adjustment" model="ir.sequence">
            <field name="name">Ajuste Manual ASOSIGMA</field>
            <field name="code">asosigma.manual.adjustment</field>
            <field name="prefix">MANUAL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>