<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista -->
    <record id="view_partner_tax_tag_tree" model="ir.ui.view">
        <field name="name">partner.tax.tag.tree</field>
        <field name="model">partner.tax.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Vista Formulario -->
    <record id="view_partner_tax_tag_form" model="ir.ui.view">
        <field name="name">partner.tax.tag.form</field>
        <field name="model">partner.tax.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>