<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record model="ir.ui.view" id="view_budget_post_form_inherit">
        <field name="name">account.budget.post.form.inherit</field>
        <field name="model">account.budget.post</field>
        <field name="inherit_id" ref="account_budget.view_budget_post_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="account_budget_type_id"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_budget_post_tree_inherit">
        <field name="name">account.budget.post.tree.inherit</field>
        <field name="model">account.budget.post</field>
        <field name="inherit_id" ref="account_budget.view_budget_post_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="account_budget_type_id"/>
            </xpath>
        </field>
    </record>

</odoo>