<odoo>
    <record id="action_trial_balance_filtered" model="ir.actions.client">
        <field name="name">Balance de Comprobación Filtrado</field> <field name="tag">account_report</field>
        <field name="context">{'report_id': 12, 'custom_handler_model_name': 'account.trial.balance.report.handler.filtered'}</field>
    </record>

    <record id="action_trial_balance_nofilter" model="ir.actions.client">
        <field name="name">Balance de Comprobación Original</field>
        <field name="tag">account_report</field>
        <field name="context">{'report_id': 12, 'no_filter': True}</field>
    </record>
    <menuitem id="menu_trial_balance_filtered" name="Balanza de comprobación resumido" parent="account_reports.account_reports_audit_reports_menu" action="action_trial_balance_filtered" sequence="10"/>

    <menuitem id="menu_trial_balance_nofilter" name="Balanza de comprobación detallado" parent="account_reports.account_reports_audit_reports_menu" action="action_trial_balance_nofilter" sequence="10"/>

    <delete model="ir.ui.menu" id="account_reports.menu_action_account_report_coa"/>
    
</odoo>