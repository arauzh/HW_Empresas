<odoo>
    <!-- Grupo de seguridad -->
    <record id="group_asosigma" model="res.groups">
        <field name="name">ASOSIGMA</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <data noupdate="1">
        <record id="employee_unique_multi_company_rule" model="ir.rule">
            <field name="name">Employee Unique Multi-Company Rule</field>
            <field name="model_id" ref="model_employee_unique"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
