<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    PDF report Template-->
    <template id="loan_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- <h4>TABLE FOR ACCOUNTING OPERATION</h4> -->
                    <!-- <div>
                        <group>
                            <strong>Debtor:</strong>
                            <span t-esc="data['Customer']"/>
                            <br/>
                            <strong>Loan Amount:</strong>
                            <span t-esc="data['Loan_Amount']"/>
                            <br/>
                            <strong>Interest Rate:</strong>
                            <span t-esc="data['Interest_Rate']"/>
                            <br/>
                            <strong>Tenure:</strong>
                            <span t-esc="data['Tenure']"/>
                            <br/>
                        </group>
                    </div> -->
                    <div class="row mb-3">
                        <div class="col-4"></div>
                        <div class="col-4">
                            <h6 class="fw-bolder">TABLE FOR ACCOUNTING OPERATION</h6>
                        </div>
                        <div class="col-4"></div>
                    </div>
                    <div id="informations" class="row mb-3">
                        <div class="col-4">
                            <p style="font-size: 13px;" class="m-0">
                                <strong class="fw-bolder">Debtor:</strong>
                                <span t-esc="data['Customer']"></span>
                            </p>
                        </div>
                        <div class="col-4">
                            <p style="font-size: 13px;" class="m-0">
                                <strong class="fw-bolder">Loan Amount:</strong>
                                <span t-esc="data['Loan_Amount']"></span>
                            </p>
                        </div>
                        <div class="col-4">
                            <p style="font-size: 13px;" class="m-0">
                                <strong class="fw-bolder">Interest Rate:</strong>
                                <span t-esc="data['Interest_Rate']"></span>
                            </p>
                        </div>
                    </div>
                    <!-- <group>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Loan Type</th>
                                    <th>Tenure</th>
                                    <th>Loan Amount</th>
                                    <th>Interest Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <td align="center">
                                    <t t-esc="data['Loan_Type']"/>
                                </td>
                                <td align="center">
                                    <t t-esc="data['Tenure']"/>
                                </td>
                                <td align="center">
                                    <t t-esc="data['Loan_Amount']"/>
                                </td>
                                <td align="center">
                                    <t t-esc="data['Interest_Rate']"/>
                                </td>
                            </tbody>
                        </table>
                    </group> -->
                    <!-- <h3 align="center">Amortization Schedule</h3> -->
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <!-- <th>Name</th> -->
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Capital balance</th>
                                <th>Interest Amount</th>
                                <th>Total Amount</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="i" t-value="1"/>
                            <tr t-foreach="docs" t-as="line">
                                <td align="center" style="font-size: 11px;">
                                    <span t-esc="i"/>
                                    <t t-set="i" t-value="i+1"/>
                                </td>
                                <!-- <td align="center" style="font-size: 11px;">
                                    <t t-esc="line['name']"/>
                                </td> -->
                                <td align="center" style="font-size: 11px;">
                                    <t t-esc="line['date']"/>
                                </td>
                                <td align="right" style="font-size: 11px;">
                                    <t t-esc="line['amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td align="right" style="font-size: 11px;">
                                    <t t-esc="line['capital_balance']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td align="right" style="font-size: 11px;">
                                    <t t-esc="line['interest_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td align="right" style="font-size: 11px;">
                                    <t t-esc="line['total_amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td align="center" style="font-size: 9px;"
                                    t-att-style="'color: ' + ('green' if line['state'] == 'paid' else ('sienna' if line['state'] == 'invoiced' else 'red'))">
                                    <t t-esc="{'unpaid': 'Unpaid', 'invoiced': 'Invoiced', 'paid': 'Paid'} [line['state']]"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>