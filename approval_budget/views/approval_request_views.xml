<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_budget_request_view_form_inherit" model="ir.ui.view">
        <field name="name">approval.budget.request.view.form.inherit</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook/page[@name='products']" position="after">
                <field name="has_budget" invisible="1"/>
                <page string="Budget" name="budget" invisible="has_budget == 'no'">
                    <field name="approval_budget_ids" readonly="request_status != 'new'">
                        <tree string="Budget Lines" editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="general_budget_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" />
                            <field name="analytic_account_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" groups="analytic.group_analytic_accounting"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="planned_amount" sum="Planned Amount"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>