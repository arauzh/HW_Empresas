<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_budget_request_view_form_inherit" model="ir.ui.view">
        <field name="name">approval.budget.request.view.form.inherit</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[@name='request_details']" position="inside">
                <field name="currency_id" invisible="True"/>  
                <field name="planned_total" invisible="has_budget == 'no'"/>  
                <field name="total_executed" invisible="has_budget == 'no'"/>  
            </xpath>
            <xpath expr="//form/sheet/notebook/page[@name='products']" position="after">
                <field name="has_budget" invisible="1"/>
                <page string="Budget" name="budget" invisible="has_budget == 'no'">
                    <field name="approval_budget_ids" readonly="request_status != 'new'" widget="section_and_note_one2many">
                        <tree string="Budget Lines" editable="bottom" default_order="sequence">
                            <control>
                                <create name="add_line_control" string="Add line"/>
                                <create name="add_section_control" string="Add section" context="{'default_display_type': 'line_section'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>        
                            <field name="display_type" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="general_budget_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" invisible="display_type"/>
                            <field name="name" widget="section_and_note_text" optional="show"/>
                            <field name="analytic_account_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" groups="analytic.group_analytic_accounting" optional="hide"/>
                            <field name="date_from" invisible="display_type"/>
                            <field name="date_to" invisible="display_type"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="planned_amount" sum="Planned Amount" optional="show"/>
                            <field name="executed_amount" sum="Executed amount" optional="show"/>
                            <field name="planned_subtotal" 
                                readonly="1"
                                invisible="display_type != 'line_section'" optional="show"/>
                            <field name="executed_subtotal" 
                                readonly="1"
                                invisible="display_type != 'line_section'" optional="show"/>

                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>