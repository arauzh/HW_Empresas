<odoo>
    <record id="view_balance_general_wizard_form" model="ir.ui.view">
        <field name="name">balance.general.wizard.form</field>
        <field name="model">custom.balance.general.wizard</field>
        <field name="arch" type="xml">
            <form string="Balance General">
                <group>
                    <field name="date_to"/>
                    <field name="target_move" widget="radio"/>
                    <field name="company_id" invisible="1"/>
                    <field name="folio" placeholder="Ej: 001-2024"/>
                </group>

                <footer>
                    <button name="action_print_report"
                            string="Exportar PDF"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_balance_general_wizard" model="ir.actions.act_window">
        <field name="name">Balance General</field>
        <field name="res_model">custom.balance.general.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_balance_general"
              name="Balance General"
              parent="menu_report_control_root"
              action="action_balance_general_wizard"
              sequence="10"/>
</odoo>