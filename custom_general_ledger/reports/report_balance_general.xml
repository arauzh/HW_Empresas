<odoo>

    <record id="paperformat_balance_general" model="report.paperformat">
        <field name="name">Balance General Formato</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">45</field>
        <field name="margin_right">40</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_balance_general" model="ir.actions.report">
        <field name="name">Balance General</field>
        <field name="model">custom.balance.general.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_general_ledger.template_balance_general</field>
        <field name="report_file">custom_general_ledger.template_balance_general</field>
        <field name="binding_model_id" ref="model_custom_balance_general_wizard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="custom_general_ledger.paperformat_balance_general"/>
    </record>


    <template id="template_balance_general">
        <t t-call="web.html_container">
            <div class="header" style="width:100%; font-size:13px; font-family:Helvetica,Arial,sans-serif; box-sizing:border-box;">

                <span id="_folio_base" style="display:none;" t-att-data-folio="folio_base"/>

    <div class="container-fluid p-0">
        <div class="row g-0" style="width: 100%;">
            
            <div class="col-6 text-start">
                <div style="font-size:15px; font-weight:bold;">
                    <t t-esc="company.name"/>
                </div>
                <div>
                    <strong>NIT:</strong> <t t-esc="company.vat"/>
                </div>
                <div style="font-weight:bold;">LIBRO: BALANCES</div>
                <div>
                    <strong>PERIODO:</strong> <t t-esc="periodo"/>
                </div>
            </div>

            <div class="col-6 text-end">
                <t t-if="folio_base">
                    <strong>FOLIO: <span id="_folio_num"/></strong>
                </t>
            </div>
            
        </div>
    </div>

    <hr style="border-top:2px solid black; margin:5px 0; width:100%;"/>

                <script type="text/javascript">
                //<![CDATA[
                function subst() {
                    var vars = {};
                    var parts = document.location.search.substring(1).split('&');
                    for (var i = 0; i < parts.length; i++) {
                        var z = parts[i].split('=', 2);
                        if (z[0]) vars[z[0]] = unescape(z[1] || '');
                    }

                    var classNames = [
                        'frompage','topage','page',
                        'webpage','section','subsection','subsubsection'
                    ];
                    for (var c = 0; c < classNames.length; c++) {
                        var elems = document.getElementsByClassName(classNames[c]);
                        for (var e = 0; e < elems.length; e++) {
                            elems[e].textContent = vars[classNames[c]] || '';
                        }
                    }

                    var page    = parseInt(vars['page'] || '1');
                    var baseEl  = document.getElementById('_folio_base');
                    var numEl   = document.getElementById('_folio_num');
                    if (baseEl && numEl) {
                        var base = parseInt(baseEl.getAttribute('data-folio') || '0');
                        if (base > 0) {
                            numEl.textContent = String(base + page - 1);
                        }
                    }
                }
                //]]>
                </script>
            </div>


            <div class="article">
                <div class="page">
				<style>
                        table { font-size: 12px; }
                    </style>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr class="table-active">
                                <th>Código</th>
                                <th>Descripción</th>
                                <th class="text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="l">

                                <tr t-if="l['type'] == 'l1'" class="fw-bold">
                                    <td colspan="3">
                                        <strong><t t-esc="l['name']"/></strong>
                                    </td>
                                </tr>

                                <tr t-if="l['type'] == 'l2'">
                                    <td/>
                                    <td colspan="2">
                                        <strong><t t-esc="l['name']"/></strong>
                                    </td>
                                </tr>

                                <tr t-if="l['type'] == 'l3'">
                                    <td/>
                                    <td>
                                        <t t-esc="l['code']"/> -
                                        <t t-esc="l['name']"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="l['balance']"
                                           t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>

                                <tr t-if="l['type'] == 'total_l2'" class="fw-bold">
                                    <td/>
                                    <td><t t-esc="l['name']"/></td>
                                    <td class="text-end">
                                        <strong>
                                            <t t-esc="l['balance']"
                                               t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>

                            </t>
                        </tbody>
                    </table>

                    <br/>
                    <h4>Resumen</h4>
                    <table class="table table-sm table-bordered" style="width:100%;">
                        <tbody>
                            <t t-foreach="summary.values()" t-as="s">
                                <tr>
                                    <td><t t-esc="s['name']"/></td>
                                    <td class="text-end">
                                        <span t-esc="s['balance']"
                                              t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2">
                                    <hr style="border-top:2px solid black; margin:3px 0;"/>
                                </td>
                            </tr>
                            <tr style="font-weight:bold;">
                                <td>TOTAL BALANCE GENERAL</td>
                                <td class="text-end">
                                    <span t-esc="total_general"
                                          t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>

        </t>
    </template>

</odoo>