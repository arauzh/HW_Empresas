<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_invoice_password_Landscape" model="report.paperformat">
        <field name="name">Half-letter invoice password</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">139</field>
        <field name="page_width">215</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

   <record id="action_password_receipt" model="ir.actions.report">
       <field name="name">Invoices password</field>
       <field name="model">account_password.account_password</field>
       <field name="report_type">qweb-pdf</field>
       <field name="paperformat_id" ref="account_password.paperformat_invoice_password_Landscape"/>
       <field name="report_name">account_password.password_receipt_print</field>
       <field name="report_file">account_password.password_receipt</field>
       <field name="print_report_name">'Invoices password - %s' % (object.name)</field>
       <field name="binding_model_id" ref="account_password.model_account_password_account_password"/>
       <field name="binding_type">report</field>
   </record>
</odoo>