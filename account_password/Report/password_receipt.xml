<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="password_receipt_temp">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rec">
                <div class="header">
                    <div class="row" style="report_header_style">
                        <table style="width: 100%; border-color:rgba(0, 0, 0, 0);">
                            <tr>
                                <td>
                                    <img src='/odoomaq/static/description/icon.png' style="max-height: 75px;"/>
                                </td>
                                <td> 
                                    <div class="text-center">
                                        <h4><t t-esc="rec.company_id.name"/></h4>
                                    </div>
                                </td>
                                <td >
                                    <div class="text-end">
                                        <img src='/odoomaq/static/description/HWlogo.jpg' style="max-height: 75px;"/>
                                    </div>
                                </td>
                            </tr>
                        </table>                        
                    </div>
                </div>
                <div class="article o_report_layout_standard"> 
                    <div class="oe_structure"/>
                    <h2>
                        <span t-field="rec.name"/>
                    </h2>
                    <div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <!-- <th scope="col" class="align-middle">Password No.</th> -->
                                    <th scope="col" class="align-middle">Date</th>
                                    <th scope="col" class="align-middle">Supplier</th>
                                    <th scope="col" class="align-middle">NIT</th>
                                </tr>
                            </thead>
                            <tbody class="table-group-divider">
                                <t t-set= "var_datenow" t-value= "datetime.datetime.now().strftime('%d/%m/%Y')"/>
                                <tr>
                                    <!-- <td><strong style="font-size: 14px;"><t t-esc="rec.name"/></strong></td> -->
                                    <td class="text-center"><strong style="font-size: 14px;" ><t t-esc="var_datenow"/></strong></td>
                                    <td><strong style="font-size: 14px;"><t t-esc="rec.partner_id.name"/></strong></td>
                                    <td class="text-center"><strong style="font-size: 14px;"><t t-esc="rec.partner_id.vat"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="oe_structure"/>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th scope="col" class="align-middle">Invoice</th>
                                <th scope="col" class="align-middle">Series</th>
                                <th scope="col" class="align-middle">Number</th>
                                <th scope="col" class="align-middle">Amount</th>
                                <th scope="col" class="align-middle">Invoice date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rec.account_move_ids" t-as="line">
                                <td style="font-size: 14px;">
                                    <strong><span t-field="line.name"></span></strong>
                                </td>
                                <td style="font-size: 14px;">
                                    <strong><span t-field="line.fac_serie"></span></strong>
                                </td>
                                <td style="font-size: 14px;">
                                    <strong><span t-field="line.fac_numero"></span></strong>
                                </td>
                                <td style="font-size: 14px;" class="text-end">
                                    <strong t-if="line.amount_total_signed &lt; 0"><span t-esc="line.amount_total_signed * (-1)" t-options='{"widget": "monetary", "display_currency": line.currency_id}'></span></strong>
                                </td>
                                <td style="font-size: 14px;">
                                    <strong><span t-field="line.invoice_date"></span></strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="oe_structure"/>
                    <div style="width: 63%; font-size: 16px;">
                        <P>This counter-receipt does not imply a commitment to pay, only the simple receipt of the documents indicated for review and timely payment, if applicable.</P>
                    </div>
                    <div class="oe_structure"/>
                    <div>
                        <P style="font-size: 18px;" class="fw-bold">RECEPTION DAYS: TUESDAYS AND THURSDAYS</P>
                    </div>
                    <div class="oe_structure"/>
                </div>
                <div class="footer o_standard_footer">
                </div>
            </t>
        </t>
    </template>

    <template id="password_receipt_doc">
        <t t-if="not o" t-set="o" t-value="rec"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <div t-attf-class="o_company_#{company.id}_layout header" t-att-style="report_header_style">
            <div class="o_background_header">
            <div class="float-end">
                <div class="mt0 text-end h3" t-if="company.report_header" t-field="company.report_header">Company tagline</div>
            </div>
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="float-start" alt="Logo"/>
            <div class="float-start company_address">
                <ul class="list-unstyled" name='company_address_list'>
                    <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                            <strong>Company address block</strong>
                            <div>Contains the company address.</div>
                        </div>
                    </span></li>
                    <li t-else="">
                        <span t-field="company.company_details">
                            <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                <strong>Company details block</strong>
                                <div>Contains the company details.</div>
                            </div>
                        </span>
                    </li>
                    <li t-if="not forced_vat"/>
                    <li t-else="">
                        <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                        <span t-esc="forced_vat">US12345671</span>
                    </li>
                </ul>
            </div>
            <div class="clearfix mb8"/>
            </div>
        </div>

        <div t-attf-class="article o_report_layout_striped" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div class="page">
                <div id="informations" class="row mb-3">
                    <div class="col-10">
                        <h4>
                            <span t-field="o.name"></span>
                        </h4>
                    </div>
                </div>
                <div>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <!-- <th scope="col" class="align-middle">Password No.</th> -->
                                <th scope="col" class="align-middle" style="font-size: 11px;">Date</th>
                                <th scope="col" class="align-middle" style="font-size: 11px;">Supplier</th>
                                <th scope="col" class="align-middle" style="font-size: 11px;">NIT</th>
                            </tr>
                        </thead>
                        <tbody class="table-group-divider">
                            <!-- <t t-set= "var_datenow" t-value= "datetime.datetime.now().strftime('%d/%m/%Y')"/> -->
                            <t t-set= "var_datenow" t-value="datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=-6))).strftime('%d/%m/%Y')"/>
                            <tr>
                                <!-- <td><strong style="font-size: 14px;"><t t-esc="rec.name"/></strong></td> -->
                                <td class="text-center"><strong style="font-size: 10px;" ><t t-esc="var_datenow"/></strong></td>
                                <td><strong style="font-size: 10px;"><t t-esc="rec.partner_id.name"/></strong></td>
                                <td class="text-center"><strong style="font-size: 10px;"><t t-esc="rec.partner_id.vat"/></strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="oe_structure"/>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th scope="col" class="align-middle" style="font-size: 11px;">Invoice</th>
                            <th scope="col" class="align-middle" style="font-size: 11px;">Series</th>
                            <th scope="col" class="align-middle" style="font-size: 11px;">Number</th>
                            <th scope="col" class="align-middle" style="font-size: 11px;">Amount</th>
                            <th scope="col" class="align-middle" style="font-size: 11px;">Invoice date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rec.account_move_ids" t-as="line">
                            <td style="font-size: 10px;">
                                <strong><span t-field="line.name"></span></strong>
                            </td>
                            <td style="font-size: 10px;">
                                <strong><span t-field="line.fac_serie" class="text-center"></span></strong>
                            </td>
                            <td style="font-size: 10px;">
                                <strong><span t-field="line.fac_numero" class="text-center"></span></strong>
                            </td>
                            <td style="font-size: 10px;" class="text-end">
                                <strong t-if="line.amount_total_signed &lt; 0"><span t-esc="line.amount_total_signed * (-1)" t-options='{"widget": "monetary", "display_currency": line.currency_id}'></span></strong>
                            </td>
                            <td style="font-size: 10px;" class="text-center">
                                <strong><span t-field="line.invoice_date"></span></strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="oe_structure"/>
                <div style="width: 56%; font-size: 14px;">
                    <P>This counter-receipt does not imply a commitment to pay, only the simple receipt of the documents indicated for review and timely payment, if applicable.</P>
                </div>
                <div class="oe_structure"/>
                <div>
                    <P style="font-size: 16px;" class="fw-bold">RECEPTION DAYS: TUESDAYS AND THURSDAYS</P>
                </div>
                <div class="oe_structure"/>
            </div>
        </div>

        <div t-attf-class="o_company_#{company.id}_layout footer o_background_footer">
            <div class="text-center">
                <ul class="list-inline">
                    <div t-field="company.report_footer"/>
                </ul>
                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page:
                    <span class="page"/>
                    of
                    <span class="topage"/>
                </div>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                    <span t-out="o.name">(document name)</span>
                </div>
            </div>
        </div>
    </template>

    <template id="password_receipt_print">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rec">
                <t t-call="account_password.password_receipt_doc"/>
            </t>
        </t>
    </template>
</odoo>