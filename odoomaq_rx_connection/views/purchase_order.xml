<odoo>
    <data>
        <record id="odoomaq_view_purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">odoomaq.purchase.purchase_order_form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[@name='products']/field[@name='order_line']/tree/field[@name='price_total']" position="after">
                    <field name="origin_order_line_id" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
