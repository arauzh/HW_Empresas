<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record model="ir.ui.view" id="view_account_analytic_account_form_inherit_api">
            <field name="name">account.analytic.account.form.inherit.api</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
            <field name="priority" eval="60"/>
            <field name="arch" type="xml">
                <xpath  expr="//group[@name='main']/group[1]" position='inside'>
                    <field name="send_to_project" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>
</odoo>
